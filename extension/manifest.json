{
  "manifest_version": 3,
  "name": "CoverCraft — Job Extractor",
  "version": "1.0.0",
  "description": "Extract job descriptions from LinkedIn, Indeed, Glassdoor, StepStone and XING with one click.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "CoverCraft"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://www.glassdoor.de/*",
    "https://www.stepstone.de/*",
    "https://www.xing.com/*",
    "http://localhost/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*",
        "https://www.glassdoor.com/job*",
        "https://www.glassdoor.de/job*",
        "https://www.stepstone.de/*",
        "https://www.xing.com/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icons16.png",
    "48":  "icons/icons48.png",
    "128": "icons/icons128.png"
  }
}
